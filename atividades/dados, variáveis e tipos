14,
INICIO
    VARIAVEL float: media
    VARIAVEL bool: aprovado = falso

    RECEBA string: aluno
    RECEBA float: nota1
    RECEBA float: nota2

    media <- (nota1 + nota2) / 2

    aprovado <- (media >= 7,0)

    EXIBIR "aluno de nome: " , aluno
    EXIBIR "com média: " , media
    EXIBIR "está aprovado? " , aprovado
FIM


