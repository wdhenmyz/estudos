16,
INICIO
    VARIAVEL float: valor_diaria = 15
    VARIAVEL float: total_aluguel

    RECEBA string: nome
    RECEBA numero: idade
    RECEBA float: altura
    RECEBA char: categoria_bicicleta
    RECEBA numero: dias_alugados

    total_aluguel <- dias_alugados * valor_diaria

    EXIBIR "cliente cadastrado"
    EXIBIR "==============================================="
    EXIBIR "nome do cliente:", nome
    EXIBIR "idade do cliente:", idade
    EXIBIR "altura do cliente:", altura
    EXIBIR "categoria da bicicleta:", categoria_bicicleta
    EXIBIR "valor da diária:", valor_diaria
    EXIBIR "dias alugados:", dias_alugados
    EXIBIR "valor total do aluguel:", total_aluguel
    EXIBIR "==============================================="
FIM
