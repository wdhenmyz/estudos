2. Saldo Positivo
INICIO
    VARIAVEL float: saldo = RECEBA()
    
    SE (saldo > 0)
        EXIBIR "conta possui saldo disponível"
    FIMSE
FIM


3. Número Par
INICIO
    VARIAVEL numero: numero = RECEBA()

    SE (numero % 2 === 0)
        EXIBIR "número é par"
    FIMSE
FIM


4. Aprovação Escolar
INICIO
    VARIAVEL string: nome = RECEBA()
    VARIAVEL float: nota = RECEBA()

    EXIBIR "aluno: " . nome

    SE (nota >= 7)
        EXIBIR "situação: aprovado"
    SENÃO
        EXIBIR "situação: reprovado"
    FIMSE
FIM


5. Caixa Eletrônico
INICIO
    VARIAVEL float: saldo = RECEBA()
    VARIAVEL float: saque = RECEBA()

    SE (saldo >= saque)
        EXIBIR "saque efetuado"
        EXIBIR "saldo atual: " . saldo - saque
    SENÃO
        EXIBIR "saque não realizado por saldo insuficiente"
    FIMSE
FIM


6. Login
INICIO
    VARIAVEL string: login_usuario = RECEBA()
    VARIAVEL string: login_senha = RECEBA()

    VARIAVEL string: usuario = "user"
    VARIAVEL string: senha = "password"

    SE (login_usuario === usuario) E (login_senha === senha)
        EXIBIR "acesso permitido, bem vindo"
    SENÃO
        EXIBIR "acesso negado, login ou senha incorretos"
    FIMSE
FIM


