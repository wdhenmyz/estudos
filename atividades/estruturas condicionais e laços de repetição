18. Sistema de Cadastro de Alunos
INICIO
    VARIAVEL numero: quantidade_alunos = RECEBA()
    VARIAVEL numero: aprovados
    VARIAVEL numero: reprovados
    VARIAVEL float: média = 0
    VARIAVEL float: maior_nota = 0
    VARIAVEL float: menor_nota = 10

    VARIAVEL numero: contador = quantidade_alunos

    ENQUANTO contador > 0
        VARIAVEL string: nome = RECEBA()
        VARIAVEL float: nota = RECEBA()

        EXIBIR "situação do aluno: " . nome
        SE (nota >= 7)
            EXIBIR "aluno foi aprovado"
            aprovados <- aprovados + 1
        SENÃO
            EXIBIR "aluno foi reprovado"
            reprovados <- reprovados + 1
        FIMSE

        SE (nota > maior_nota)
            maior_nota <- nota
        SENÃO SE (nota < menor_nota)
            menor_nota <- nota
        FIMSE
        
        média = media + nota
        contador <- contador - 1
    FIMENQUANTO

    EXIBIR "quantidade de aprovados: " . aprovados
    EXIBIR "quantidade de reprovados: " . reprovados
    EXIBIR "média geral da turma: " . média / quantidade_alunos
    EXIBIR "maior nota: " . maior_nota
    EXIBIR "menor nota: " . menor_nota
FIM


19. Sistema de Menu
INICIO
    VARIAVEL numero: opcao = 0 // valor inicial
    
    ENQUANTO opcao != 5 // loop principal
        EXIBIR "========== MENU =========="
        EXIBIR "1 - Somar dois números"
        EXIBIR "2 - Calcular média"
        EXIBIR "3 - Verificar se um número é par"
        EXIBIR "4 - Fazer contagem de 1 até N"
        EXIBIR "5 - Sair"
        EXIBIR "=========================="
        EXIBIR "Escolha uma opção: "
        opcao = RECEBEA() // recebe input do usuário
        
        SE (opcao == 1) // Somar dois números
            VARIAVEL float: num1 = RECEBEA()
            VARIAVEL float: num2 = RECEBEA()
            EXIBIR "Resultado da soma: " . (num1 + num2)
        
        SENAO SE (opcao == 2) // Calcular média
            VARIAVEL numero: qtd = RECEBEA()
            VARIAVEL float: soma = 0
            VARIAVEL numero: contador = qtd
            
            ENQUANTO contador > 0
                VARIAVEL float: valor = RECEBEA()
                soma = soma + valor
                contador = contador - 1
            FIMENQUANTO
            
            EXIBIR "Média: " . (soma / qtd)
        
        SENAO SE (opcao == 3) // Verificar se é par
            VARIAVEL numero: numero = RECEBEA()
            SE (numero % 2 == 0)
                EXIBIR "O número " . numero . " é par"
            SENAO
                EXIBIR "O número " . numero . " é ímpar"
            FIMSE
        
        SENAO SE (opcao == 4) // Contagem de 1 até N
            VARIAVEL numero: N = RECEBEA()
            VARIAVEL numero: contador = 1
            
            ENQUANTO contador <= N
                EXIBIR contador
                contador = contador + 1
            FIMENQUANTO
        
        SENAO SE (opcao == 5) // Sair
            EXIBIR "Saindo do programa..."
        
        SENAO // opção inválida
            EXIBIR "Opção inválida! Tente novamente."
        FIMSE
        
        EXIBIR "" // linha em branco para organizar
    FIMENQUANTO
FIM
