15. Média da Turma
INICIO
    EXIBIR "quantas notas serão informadas?"
    VARIAVEL numero: quantidade_notas = RECEBA()
    VARIAVEL numero: contador = quantidade_notas
    VARIAVEL float: média
    
    ENQUANTO contador > 0
        VARIAVEL numero: notas = RECEBA()
        média <- média + notas
        contador <- contador - 1
    FIMENQUANTO

    média <- média / quantidade_notas

    EXIBIR "média das notas: " . média
FIM


