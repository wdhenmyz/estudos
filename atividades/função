13. Sistema Escolar
INICIO
    // Função para calcular média
    função calcularMedia(nota1, nota2, nota3)
    INICIO
        RETORNE (nota1 + nota2 + nota3) / 3
    FIM

    // Função para verificar aprovação
    função verificarAprovacao(media)
    INICIO
        SE media >= 7
            RETORNE "APROVADO"
        SENAO SE media >= 5
            RETORNE "RECUPERAÇÃO"
        SENAO
            RETORNE "REPROVADO"
        FIMSE
    FIM

    // Função para classificar desempenho
    função classificarDesempenho(media)
    INICIO
        SE media >= 9
            RETORNE "EXCELENTE"
        SENAO SE media >= 7
            RETORNE "BOM"
        SENAO SE media >= 5
            RETORNE "REGULAR"
        SENAO
            RETORNE "INSATISFATÓRIO"
        FIMSE
    FIM

    // Procedimento para mostrar relatório
    procedimento mostrarRelatorio(nome, media, situacao, desempenho)
    INICIO
        EXIBIR "========== RELATÓRIO =========="
        EXIBIR "Aluno: " . nome
        EXIBIR "Média: " . media
        EXIBIR "Situação: " . situacao
        EXIBIR "Desempenho: " . desempenho
        EXIBIR "================================"
    FIM

    procedimento main()
    INICIO
        VARIAVEL string: nome
        VARIAVEL float: n1, n2, n3
        VARIAVEL float: media
        VARIAVEL string: situacao
        VARIAVEL string: desempenho
        
        EXIBIR "Nome do aluno: "
        nome <- RECEBEA()
        EXIBIR "Nota 1: "
        n1 <- RECEBEA()
        EXIBIR "Nota 2: "
        n2 <- RECEBEA()
        EXIBIR "Nota 3: "
        n3 <- RECEBEA()
        
        media = calcularMedia(n1, n2, n3)
        situacao = verificarAprovacao(media)
        desempenho = classificarDesempenho(media)
        mostrarRelatorio(nome, media, situacao, desempenho)
    FIM
FIM

