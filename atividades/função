14. Sistema de Biblioteca
INICIO
    // Função para verificar idade
    função verificarIdade(idade)
    INICIO
        SE idade >= 18
            RETORNE "Maior de idade"
        SENAO
            RETORNE "Menor de idade"
        FIMSE
    FIM

    // Função para verificar cadastro
    função verificarCadastro(cadastrado)
    INICIO
        SE cadastrado == "sim"
            RETORNE "Cadastro ativo"
        SENAO
            RETORNE "Sem cadastro"
        FIMSE
    FIM

    // Função para verificar empréstimo
    função verificarEmprestimo(ativo, idade)
    INICIO
        SE ativo == "sim" E idade >= 18
            RETORNE "Permitido"
        SENAO
            RETORNE "Negado"
        FIMSE
    FIM

    // Procedimento para exibir resultado final
    procedimento exibirResultado(nome, Idade, Cadastro, Emprestimo)
    INICIO
        EXIBIR "========== BIBLIOTECA =========="
        EXIBIR "Usuário: " . nome
        EXIBIR "Status idade: " . Idade
        EXIBIR "Status cadastro: " . Cadastro
        EXIBIR "Status empréstimo: " . Emprestimo
        EXIBIR "================================="
    FIM

    procedimento main()
    INICIO
        VARIAVEL string: nome
        VARIAVEL numero: idade
        VARIAVEL string: cadastrado
        VARIAVEL string: statusIdade
        VARIAVEL string: statusCadastro
        VARIAVEL string: statusEmprestimo
        
        EXIBIR "Nome do usuário: "
        nome <- RECEBEA()
        EXIBIR "Idade: "
        idade <- RECEBEA()
        EXIBIR "Está cadastrado? (sim/nao): "
        cadastrado <- RECEBEA()
        
        statusIdade = verificarIdade(idade)
        statusCadastro = verificarCadastro(cadastrado)
        statusEmprestimo = verificarEmprestimo(cadastrado, idade)
        exibirResultado(nome, statusIdade, statusCadastro, statusEmprestimo)
    FIM
