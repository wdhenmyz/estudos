12. Caixa Eletrônico
INICIO
    VARIAVEL float: saldo = 1000.00 // saldo inicial
    
    função verificarSaldo()
    INICIO
        RETORNE saldo
    FIM

    função sacar(valor)
    INICIO
        SE valor > saldo
            EXIBIR "Saldo insuficiente!"
            RETORNE 0
        SENAO
            saldo <- saldo - valor
            RETORNE valor
        FIMSE
    FIM

    função depositar(valor)
    INICIO
        saldo <- saldo + valor
        RETORNE saldo
    FIM

    procedimento main()
    INICIO
        VARIAVEL numero: opcao = 0
        VARIAVEL float: valor
        
        ENQUANTO opcao != 4
            EXIBIR "===== CAIXA ELETRÔNICO ====="
            EXIBIR "1 - Verificar saldo"
            EXIBIR "2 - Sacar"
            EXIBIR "3 - Depositar"
            EXIBIR "4 - Sair"
            EXIBIR "==========================="
            EXIBIR "Opção: "
            opcao <- RECEBEA()
            
            SE opcao == 1
                EXIBIR "Saldo atual: R$ " . verificarSaldo()
            SENAO SE opcao == 2
                EXIBIR "Valor para sacar: "
                valor <- RECEBEA()
                sacar(valor)
                EXIBIR "Novo saldo: R$ " . verificarSaldo()
            SENAO SE opcao == 3
                EXIBIR "Valor para depositar: "
                valor <- RECEBEA()
                depositar(valor)
                EXIBIR "Novo saldo: R$ " . verificarSaldo()
            SENAO SE opcao == 4
                EXIBIR "Saindo..."
            SENAO
                EXIBIR "Opção inválida!"
            FIMSE
        FIMENQUANTO
    FIM
FIM

