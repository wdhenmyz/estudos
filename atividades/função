15. Sistema de Compras
INICIO
    // Função para calcular subtotal
    função calcularSubtotal(preco, quantidade)
    INICIO
        RETORNE preco * quantidade
    FIM

    // Função para calcular imposto
    função calcularImposto(subtotal, aliquota)
    INICIO
        RETORNE subtotal * (aliquota / 100)
    FIM

    // Função para calcular desconto
    função calcularDesconto(subtotal, percentual)
    INICIO
        RETORNE subtotal * (percentual / 100)
    FIM

    // Função para calcular valor final
    função calcularValorFinal(subtotal, imposto, desconto)
    INICIO
        RETORNE subtotal + imposto - desconto
    FIM

    // Procedimento para mostrar nota fiscal
    procedimento mostrarNotaFiscal(produto, quantidade, preco, subtotal, imposto, desconto, total)
    INICIO
        EXIBIR "========== NOTA FISCAL =========="
        EXIBIR "Produto: " . produto
        EXIBIR "Quantidade: " . quantidade
        EXIBIR "Preço unitário: R$ " . preco
        EXIBIR "---------------------------------"
        EXIBIR "Subtotal: R$ " . subtotal
        EXIBIR "Imposto (10%): R$ " . imposto
        EXIBIR "Desconto (5%): R$ " . desconto
        EXIBIR "---------------------------------"
        EXIBIR "VALOR FINAL: R$ " . total
        EXIBIR "================================="
    FIM

    procedimento main()
    INICIO
        VARIAVEL string: produto
        VARIAVEL numero: quantidade
        VARIAVEL float: preco
        VARIAVEL float: subtotal
        VARIAVEL float: imposto
        VARIAVEL float: desconto
        VARIAVEL float: total
        
        EXIBIR "Nome do produto: "
        produto <- RECEBEA()
        EXIBIR "Quantidade: "
        quantidade <- RECEBEA()
        EXIBIR "Preço unitário: "
        preco <- RECEBEA()
        
        subtotal = calcularSubtotal(preco, quantidade)
        imposto = calcularImposto(subtotal, 10) // 10% de imposto
        desconto = calcularDesconto(subtotal, 5) // 5% de desconto
        total = calcularValorFinal(subtotal, imposto, desconto)
        mostrarNotaFiscal(produto, quantidade, preco, subtotal, imposto, desconto, total)
    FIM
FIM
