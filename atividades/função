9. Loja
INICIO
    função subtotal(valores)
    INICIO
        VARIAVEL float: subtotal

        PARA CADA valor DE valores
            subtotal <- subtotal + valor
        FIMPARA

        RETORNE subtotal
    FIM

    função calcularDesconto(a)
    INICIO
        RETORNE (100 - a) * 0.01
    FIM

    função valorfinal(subtotal, desconto)
    INICIO
        SE desconto > 0
            RETORNE subtotal * desconto
        FIMSE
    FIM

    procedimento main()
    INICIO
        VARIAVEL float: subtotal = subtotal(valores)
        VARIAVEL float: desconto = calcularDesconto(valor)

        EXIBIR "subtotal: " . subtotal
        EXIBIR "desconto da compra: " . desconto
        EXIBIR "valor final: " . valorfinal(subtotal, desconto)
    FIM
FIM

