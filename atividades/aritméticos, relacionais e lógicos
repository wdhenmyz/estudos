16, Sistema de Inscrição para Campeonato
INICIO
    VARIAVEL string: nome_competidor = RECEBA()
    VARIAVEL numero: idade = RECEBA()
    VARIAVEL float: peso = RECEBA()
    VARIAVEL logico: tem_autorizacao = RECEBA()
    VARIAVEL logico: pagou_inscricao = RECEBA()
    VARIAVEL string: inscricao = "recusada"

    SE (idade >= 18 E pagou_inscricao) OU (idade >= 16 E tem_autorizacao E pagou_inscricao)
        inscricao <- "aprovado"
    FIMSE

    EXIBIR "------ competidor -------"
    EXIBIR "nome do competidor: " , nome_competidor
    EXIBIR "idade do competidor: " , idade
    EXIBIR "peso: " , peso
    EXIBIR "situação da inscrição: " , inscricao
FIM

17, Sistema de Loja Inteligente
INICIO
    VARIAVEL string: nome_cliente = RECEBA()
    VARIAVEL numero: quantidade_produto = RECEBA()
    VARIAVEL float: preco_unitario = RECEBA()
    VARIAVEL float: desconto = RECEBA()
    VARIAVEL logico: possui_cartao_fidelidade = RECEBA()

    VARIAVEL float: subtotal = quantidade_produto * preco_unitario
    VARIAVEL float: valor_desconto = subtotal * desconto
    VARIAVEL float: valor_final = subtotal - valor_desconto
    VARIAVEL logico: ehpar = (quantidade_produto % 2 === 0)

    VARIAVEL string: permite_promocao = "não"

    SE (valor_final >= 300) OU (possui_cartao_fidelidade)
        permite_promocao <- "sim"

    EXIBIR "nome do cliete:", nome_cliente
    EXIBIR "subtotal da compra: " , subtotal
    EXIBIR "valor do desconto: " , valor_desconto
    EXIBIR "valor final da compra: " , valor_final
    EXIBIR "pode participar da promoção: " , permite_promocao
FIM
