9, Comparador de Dois Números
INICIO
    VARIAVEL numero: numero1 = RECEBA()
    VARIAVEL numero: numero2 = RECEBA()

    VARIAVEL logico: ehigual = (numero1 === numero2)
    VARIAVEL logico: ehdiferente = (numero1 !== numero2)
    VARIAVEL logico: ehmaior = (numero1 > numero2)
    VARIAVEL logico: ehmenor = (numero1 < numero2)

    EXIBIR "os números são iguais?" , ehigual
    EXIBIR "os números são diferentes?" , ehdiferente
    EXIBIR "o primeiro número é maior?" , ehmaior
    EXIBIR "o primeiro número é menor?" , ehmenor
FIM


