# aritméticos, relacionais e lógicos

1, Troco da Compra
INICIO
    VARIAVEL string: nome_produto = RECEBA()
    VARIAVEL float: preco_produto = RECEBA()
    VARIAVEL float: valor_pago = RECEBA()

    VARIAVEL float: troco = valor_pago - preco_produto

    EXIBIR "--------boleto--------"
    EXIBIR "produto: " , nome_produto
    EXIBIR "preço: " , preco_produto
    EXIBIR "valor pago: " , valor_pago
    EXIBIR "troco: " , troco
FIM


