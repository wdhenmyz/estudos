Sistema Acadêmico
INICIO
    // Estruturas para armazenar dados dos alunos
    VARIAVEL string: nomes[100]
    VARIAVEL float: notas1[100]
    VARIAVEL float: notas2[100]
    VARIAVEL float: notas3[100]
    VARIAVEL float: medias[100]
    VARIAVEL string: situacoes[100]
    VARIAVEL string: classificacoes[100]
    VARIAVEL numero: totalAlunos = 0
    
    // Procedimento para ler dados de um aluno
    procedimento lerAluno(VARIAVEL string: nome, VARIAVEL float: n1, n2, n3)
    INICIO
        EXIBIR "Nome do aluno: "
        nome <- RECEBEA()
        EXIBIR "Nota 1: "
        n1 <- RECEBEA()
        EXIBIR "Nota 2: "
        n2 <- RECEBEA()
        EXIBIR "Nota 3: "
        n3 <- RECEBEA()
    FIM
    
    // Função para calcular média
    função calcularMedia(n1, n2, n3)
    INICIO
        RETORNE (n1 + n2 + n3) / 3
    FIM
    
    // Função para verificar aprovação
    função verificarAprovacao(media)
    INICIO
        SE media >= 7
            RETORNE "APROVADO"
        SENAO SE media >= 5
            RETORNE "RECUPERAÇÃO"
        SENAO
            RETORNE "REPROVADO"
        FIMSE
    FIM
    
    // Função para classificar aluno
    função classificarAluno(media)
    INICIO
        SE media >= 9
            RETORNE "EXCELENTE"
        SENAO SE media >= 7
            RETORNE "BOM"
        SENAO SE media >= 5
            RETORNE "REGULAR"
        SENAO
            RETORNE "INSATISFATÓRIO"
        FIMSE
    FIM
    
    // Procedimento para mostrar um aluno
    procedimento mostrarAluno(posicao)
    INICIO
        EXIBIR "----------------------------------------"
        EXIBIR "Aluno: " . nomes[posicao]
        EXIBIR "Média: " . medias[posicao]
        EXIBIR "Situação: " . situacoes[posicao]
        EXIBIR "Classificação: " . classificacoes[posicao]
        EXIBIR "----------------------------------------"
    FIM
    
    // Procedimento para mostrar relatório final
    procedimento mostrarRelatorioFinal()
    INICIO
        VARIAVEL numero: i
        VARIAVEL numero: aprovados = 0
        VARIAVEL numero: recuperacao = 0
        VARIAVEL numero: reprovados = 0
        VARIAVEL float: somaMedias = 0
        VARIAVEL float: mediaGeral
        
        SE totalAlunos == 0
            EXIBIR "Nenhum aluno cadastrado!"
            RETORNE
        FIMSE
        
        PARA i = 0 ATE totalAlunos - 1
            somaMedias = somaMedias + medias[i]
            
            SE situacoes[i] == "APROVADO"
                aprovados <- aprovados + 1
            SENAO SE situacoes[i] == "RECUPERAÇÃO"
                recuperacao <- recuperacao + 1
            SENAO
                reprovados <- reprovados + 1
            FIMSE
        FIMPARA
        
        mediaGeral = somaMedias / totalAlunos
        
        EXIBIR "========== RELATÓRIO FINAL =========="
        EXIBIR "Total de alunos: " . totalAlunos
        EXIBIR "----------------------------------------"
        EXIBIR "APROVADOS: " . aprovados
        EXIBIR "EM RECUPERAÇÃO: " . recuperacao
        EXIBIR "REPROVADOS: " . reprovados
        EXIBIR "----------------------------------------"
        EXIBIR "Média geral da turma: " . mediaGeral
        EXIBIR "========================================"
        
        EXIBIR ""
        EXIBIR "Detalhamento dos alunos:"
        PARA i = 0 ATE totalAlunos - 1
            mostrarAluno(i)
        FIMPARA
    FIM
    
    procedimento main()
    INICIO
        VARIAVEL numero: opcao = 0
        VARIAVEL string: nome
        VARIAVEL float: n1, n2, n3
        VARIAVEL float: media
        
        ENQUANTO opcao != 3
            EXIBIR "========== SISTEMA ACADÊMICO =========="
            EXIBIR "1 - Cadastrar aluno"
            EXIBIR "2 - Mostrar relatório"
            EXIBIR "3 - Sair"
            EXIBIR "======================================="
            EXIBIR "Opção: "
            opcao <- RECEBEA()
            
            SE opcao == 1
                lerAluno(nome, n1, n2, n3)
                
                nomes[totalAlunos] = nome
                notas1[totalAlunos] = n1
                notas2[totalAlunos] = n2
                notas3[totalAlunos] = n3
                
                media = calcularMedia(n1, n2, n3)
                medias[totalAlunos] = media
                situacoes[totalAlunos] = verificarAprovacao(media)
                classificacoes[totalAlunos] = classificarAluno(media)
                
                totalAlunos = totalAlunos + 1
                EXIBIR "Aluno cadastrado com sucesso!"
            
            SENAO SE opcao == 2
                mostrarRelatorioFinal()
            
            SENAO SE opcao == 3
                EXIBIR "Saindo do sistema..."
            
            SENAO
                EXIBIR "Opção inválida!"
            FIMSE
            
            EXIBIR ""
        FIMENQUANTO
    FIM
FIM

