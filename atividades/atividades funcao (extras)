Banco
INICIO
    VARIAVEL float: saldo = 0.00
    VARIAVEL string: titular = ""
    
    // Procedimento para mostrar o menu
    procedimento mostrarMenu()
    INICIO
        EXIBIR "========================================"
        EXIBIR "            BANCO DIGITAL"
        EXIBIR "========================================"
        EXIBIR "Titular: " . titular
        EXIBIR "----------------------------------------"
        EXIBIR "1 - Consultar saldo"
        EXIBIR "2 - Sacar"
        EXIBIR "3 - Depositar"
        EXIBIR "4 - Transferir"
        EXIBIR "5 - Sair"
        EXIBIR "========================================"
        EXIBIR "Escolha uma opção: "
    FIM
    
    // Função para consultar saldo
    função consultarSaldo()
    INICIO
        RETORNE saldo
    FIM
    
    // Função para sacar
    função sacar(valor)
    INICIO
        SE valor <= 0
            EXIBIR "Valor inválido!"
            RETORNE 0
        SENAO SE valor > saldo
            EXIBIR "Saldo insuficiente!"
            EXIBIR "Saldo disponível: R$ " . saldo
            RETORNE 0
        SENAO
            saldo <- saldo - valor
            EXIBIR "Saque realizado com sucesso!"
            EXIBIR "Novo saldo: R$ " . saldo
            RETORNE valor
        FIMSE
    FIM
    
    // Função para depositar
    função depositar(valor)
    INICIO
        SE valor <= 0
            EXIBIR "Valor inválido!"
            RETORNE 0
        SENAO
            saldo <- saldo + valor
            EXIBIR "Depósito realizado com sucesso!"
            EXIBIR "Novo saldo: R$ " . saldo
            RETORNE valor
        FIMSE
    FIM
    
    // Função para transferir
    função transferir(valor, destino)
    INICIO
        SE valor <= 0
            EXIBIR "Valor inválido!"
            RETORNE 0
        SENAO SE valor > saldo
            EXIBIR "Saldo insuficiente!"
            EXIBIR "Saldo disponível: R$ " . saldo
            RETORNE 0
        SENAO
            saldo <- saldo - valor
            EXIBIR "Transferência de R$ " . valor . " para " . destino
            EXIBIR "Realizada com sucesso!"
            EXIBIR "Novo saldo: R$ " . saldo
            RETORNE valor
        FIMSE
    FIM
    
    procedimento main()
    INICIO
        VARIAVEL numero: opcao = 0
        VARIAVEL float: valor
        VARIAVEL string: destino
        
        EXIBIR "Bem-vindo ao Banco Digital!"
        EXIBIR "Digite o nome do titular: "
        titular <- RECEBEA()
        EXIBIR "Olá " . titular . "! Vamos começar?"
        EXIBIR ""
        
        ENQUANTO opcao != 5
            mostrarMenu()
            opcao <- RECEBEA()
            
            SE opcao == 1
                EXIBIR "Saldo atual: R$ " . consultarSaldo()
            
            SENAO SE opcao == 2
                EXIBIR "Valor para sacar: R$ "
                valor <- RECEBEA()
                sacar(valor)
            
            SENAO SE opcao == 3
                EXIBIR "Valor para depositar: R$ "
                valor <- RECEBEA()
                depositar(valor)
            
            SENAO SE opcao == 4
                EXIBIR "Valor para transferir: R$ "
                valor <- RECEBEA()
                EXIBIR "Nome do destinatário: "
                destino <- RECEBEA()
                transferir(valor, destino)
            
            SENAO SE opcao == 5
                EXIBIR "Obrigado por usar o Banco Digital!"
                EXIBIR "Até logo, " . titular . "!"
            
            SENAO
                EXIBIR "Opção inválida! Tente novamente."
            FIMSE
            
            EXIBIR "" // linha em branco
        FIMENQUANTO
    FIM
FIM
