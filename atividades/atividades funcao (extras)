INICIO
    // Estrutura para armazenar contatos (simulando um vetor)
    VARIAVEL string: nomes[100]
    VARIAVEL string: telefones[100]
    VARIAVEL numero: totalContatos = 0
    
    // Procedimento para cadastrar contato
    procedimento cadastrarContato()
    INICIO
        VARIAVEL string: nome
        VARIAVEL string: telefone
        
        EXIBIR "Nome do contato: "
        nome <- RECEBEA()
        EXIBIR "Telefone: "
        telefone <- RECEBEA()
        
        nomes[totalContatos] <- nome
        telefones[totalContatos] <- telefone
        totalContatos <- totalContatos + 1
        
        EXIBIR "Contato cadastrado com sucesso!"
    FIM
    
    // Procedimento para procurar contato
    procedimento procurarContato()
    INICIO
        VARIAVEL string: busca
        VARIAVEL numero: encontrado = 0
        VARIAVEL numero: i
        
        EXIBIR "Digite o nome para buscar: "
        busca <- RECEBEA()
        
        PARA i = 0 ATE totalContatos - 1
            SE nomes[i] == busca
                EXIBIR "Contato encontrado:"
                EXIBIR "Nome: " . nomes[i]
                EXIBIR "Telefone: " . telefones[i]
                encontrado = 1
            FIMSE
        FIMPARA
        
        SE encontrado == 0
            EXIBIR "Contato não encontrado!"
        FIMSE
    FIM
    
    // Procedimento para listar todos os contatos
    procedimento listarContatos()
    INICIO
        VARIAVEL numero: i
        
        SE totalContatos == 0
            EXIBIR "Agenda vazia!"
        SENAO
            EXIBIR "========== LISTA DE CONTATOS =========="
            PARA i = 0 ATE totalContatos - 1
                EXIBIR (i + 1) . " - " . nomes[i] . " | " . telefones[i]
            FIMPARA
            EXIBIR "========================================"
        FIMSE
    FIM
    
    // Procedimento para remover contato
    procedimento removerContato()
    INICIO
        VARIAVEL string: remover
        VARIAVEL numero: posicao = -1
        VARIAVEL numero: i
        
        EXIBIR "Digite o nome do contato a remover: "
        remover <- RECEBEA()
        
        PARA i = 0 ATE totalContatos - 1
            SE nomes[i] == remover
                posicao = i
            FIMSE
        FIMPARA
        
        SE posicao == -1
            EXIBIR "Contato não encontrado!"
        SENAO
            PARA i = posicao ATE totalContatos - 2
                nomes[i] = nomes[i + 1]
                telefones[i] = telefones[i + 1]
            FIMPARA
            totalContatos <- totalContatos - 1
            EXIBIR "Contato removido com sucesso!"
        FIMSE
    FIM
    
    // Menu principal
    procedimento main()
    INICIO
        VARIAVEL numero: opcao = 0
        
        ENQUANTO opcao != 5
            EXIBIR "========== AGENDA TELEFÔNICA =========="
            EXIBIR "1 - Cadastrar contato"
            EXIBIR "2 - Procurar contato"
            EXIBIR "3 - Listar contatos"
            EXIBIR "4 - Remover contato"
            EXIBIR "5 - Sair"
            EXIBIR "======================================="
            EXIBIR "Opção: "
            opcao <- RECEBEA()
            
            SE opcao == 1
                cadastrarContato()
            SENAO SE opcao == 2
                procurarContato()
            SENAO SE opcao == 3
                listarContatos()
            SENAO SE opcao == 4
                removerContato()
            SENAO SE opcao == 5
                EXIBIR "Saindo da agenda..."
            SENAO
                EXIBIR "Opção inválida!"
            FIMSE
            
            EXIBIR "" // linha em branco
        FIMENQUANTO
    FIM
FIM

