Mini Sistema de Loja
INICIO
    // Estruturas para armazenar produtos
    VARIAVEL string: produtos[100]
    VARIAVEL numero: quantidades[100]
    VARIAVEL float: precos[100]
    VARIAVEL numero: totalProdutos = 0
    VARIAVEL float: impostoPadrao = 10 // 10%
    VARIAVEL float: fretePadrao = 5.00
    
    // ========== FUNÇÕES ==========
    
    // Função para cadastrar produto
    função cadastrarProduto()
    INICIO
        VARIAVEL string: nome
        VARIAVEL numero: qtd
        VARIAVEL float: preco
        
        EXIBIR "Nome do produto: "
        nome <- RECEBEA()
        EXIBIR "Quantidade: "
        qtd <- RECEBEA()
        EXIBIR "Preço unitário: R$ "
        preco <- RECEBEA()
        
        produtos[totalProdutos] = nome
        quantidades[totalProdutos] = qtd
        precos[totalProdutos] = preco
        totalProdutos <- totalProdutos + 1
        
        RETORNE 1 // sucesso
    FIM
    
    // Função para calcular subtotal
    função calcularSubtotal(preco, quantidade)
    INICIO
        RETORNE preco * quantidade
    FIM
    
    // Função para calcular desconto
    função calcularDesconto(subtotal, percentual)
    INICIO
        SE percentual < 0 OU percentual > 50
            RETORNE 0
        SENAO
            RETORNE subtotal * (percentual / 100)
        FIMSE
    FIM
    
    // Função para calcular imposto
    função calcularImposto(subtotal, aliquota)
    INICIO
        SE aliquota < 0
            RETORNE 0
        SENAO
            RETORNE subtotal * (aliquota / 100)
        FIMSE
    FIM
    
    // Função para calcular frete
    função calcularFrete(subtotal)
    INICIO
        SE subtotal > 100
            RETORNE 0 // frete grátis
        SENAO SE subtotal > 50
            RETORNE fretePadrao / 2
        SENAO
            RETORNE fretePadrao
        FIMSE
    FIM
    
    // Função para calcular total
    função calcularTotal(subtotal, desconto, imposto, frete)
    INICIO
        RETORNE subtotal - desconto + imposto + frete
    FIM
    
    // Função para verificar promoção
    função verificarPromocao(produto, quantidade)
    INICIO
        // Promoção: leve 3 pague 2
        SE quantidade >= 3
            VARIAVEL float: precoUnitario = 0
            VARIAVEL numero: i
            
            PARA i = 0 ATE totalProdutos - 1
                SE produtos[i] == produto
                    precoUnitario = precos[i]
                FIMSE
            FIMPARA
            
            RETORNE precoUnitario * (quantidade - 1) // desconto de 1 item
        SENAO
            RETORNE quantidade * 0 // sem desconto
        FIMSE
    FIM
    
    // ========== PROCEDIMENTOS ==========
    
    // Procedimento para exibir menu
    procedimento exibirMenu()
    INICIO
        EXIBIR "========================================"
        EXIBIR "           MINI SISTEMA DE LOJA"
        EXIBIR "========================================"
        EXIBIR "1 - Cadastrar produto"
        EXIBIR "2 - Mostrar produtos"
        EXIBIR "3 - Realizar compra"
        EXIBIR "4 - Sair"
        EXIBIR "========================================"
        EXIBIR "Opção: "
    FIM
    
    // Procedimento para mostrar produtos
    procedimento mostrarProdutos()
    INICIO
        VARIAVEL numero: i
        
        SE totalProdutos == 0
            EXIBIR "Nenhum produto cadastrado!"
        SENAO
            EXIBIR "========== PRODUTOS CADASTRADOS =========="
            PARA i = 0 ATE totalProdutos - 1
                EXIBIR (i + 1) . " - " . produtos[i]
                EXIBIR "   Quantidade: " . quantidades[i]
                EXIBIR "   Preço: R$ " . precos[i]
                EXIBIR "----------------------------------------"
            FIMPARA
            EXIBIR "============================================"
        FIMSE
    FIM
    
    // Procedimento para imprimir recibo
    procedimento imprimirRecibo(produto, quantidade, preco, subtotal, desconto, imposto, frete, total, promocao)
    INICIO
        EXIBIR "========== RECIBO DA COMPRA =========="
        EXIBIR "Produto: " . produto
        EXIBIR "Quantidade: " . quantidade
        EXIBIR "Preço unitário: R$ " . preco
        EXIBIR "----------------------------------------"
        EXIBIR "Subtotal: R$ " . subtotal
        
        SE promocao > 0
            EXIBIR "PROMOÇÃO (Leve 3 pague 2): R$ -" . promocao
        FIMSE
        
        SE desconto > 0
            EXIBIR "Desconto: R$ -" . desconto
        FIMSE
        
        EXIBIR "Imposto (10%): R$ " . imposto
        EXIBIR "Frete: R$ " . frete
        EXIBIR "----------------------------------------"
        EXIBIR "TOTAL A PAGAR: R$ " . total
        EXIBIR "========================================"
        EXIBIR "Obrigado pela compra!"
        EXIBIR "========================================"
    FIM
    
    // ========== PROGRAMA PRINCIPAL ==========
    
    procedimento main()
    INICIO
        VARIAVEL numero: opcao = 0
        VARIAVEL numero: indice
        VARIAVEL numero: quantidade
        VARIAVEL float: subtotal
        VARIAVEL float: desconto
        VARIAVEL float: imposto
        VARIAVEL float: frete
        VARIAVEL float: total
        VARIAVEL float: promocao
        
        ENQUANTO opcao != 4
            exibirMenu()
            opcao = RECEBEA()
            
            SE opcao == 1
                cadastrarProduto()
                EXIBIR "Produto cadastrado com sucesso!"
            
            SENAO SE opcao == 2
                mostrarProdutos()
            
            SENAO SE opcao == 3
                SE totalProdutos == 0
                    EXIBIR "Nenhum produto disponível!"
                SENAO
                    mostrarProdutos()
                    EXIBIR "Digite o número do produto: "
                    indice = RECEBEA() - 1
                    
                    SE indice >= 0 E indice < totalProdutos
                        EXIBIR "Quantidade: "
                        quantidade = RECEBEA()
                        
                        SE quantidade <= quantidades[indice]
                            subtotal = calcularSubtotal(precos[indice], quantidade)
                            
                            // Verifica promoção
                            promocao = verificarPromocao(produtos[indice], quantidade)
                            SE promocao > 0
                                subtotal = subtotal - promocao
                            FIMSE
                            
                            desconto = calcularDesconto(subtotal, 10) // 10% de desconto
                            imposto = calcularImposto(subtotal, impostoPadrao)
                            frete = calcularFrete(subtotal)
                            total = calcularTotal(subtotal, desconto, imposto, frete)
                            
                            imprimirRecibo(produtos[indice], quantidade, precos[indice], 
                                           subtotal, desconto, imposto, frete, total, promocao)
                            
                            // Atualiza estoque
                            quantidades[indice] = quantidades[indice] - quantidade
                        SENAO
                            EXIBIR "Quantidade indisponível em estoque!"
                            EXIBIR "Disponível: " . quantidades[indice]
                        FIMSE
                    SENAO
                        EXIBIR "Produto inválido!"
                    FIMSE
                FIMSE
            
            SENAO SE opcao == 4
                EXIBIR "Saindo do sistema..."
            
            SENAO
                EXIBIR "Opção inválida!"
            FIMSE
            
            EXIBIR ""
        FIMENQUANTO
    FIM
FIM
